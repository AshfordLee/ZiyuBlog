---
import PageLayout from '@/layouts/ContentLayout.astro'
import config from '@/site-config'

const cookieValue = Astro.cookies.get('transcript_auth')?.value
const isAuth = cookieValue === 'verified'
const transcriptPassword = config.transcript?.password

const transcripts = [
  { name: 'Graduate (CN)', path: '/transcript/Graduate_Transcript_CN.pdf', label: '研究生成绩单（中文）' },
  { name: 'Graduate (EN)', path: '/transcript/Graduate_Transcript_EN.pdf', label: 'Graduate Transcript (English)' },
  { name: 'Undergraduate (CN)', path: '/transcript/Undergraduate_Transcript_CN.pdf', label: '本科成绩单（中文）' },
  { name: 'Undergraduate (EN)', path: '/transcript/Undergraduate_Transcript_EN.pdf', label: 'Undergraduate Transcript (English)' },
]

// Redirect if no password is configured
if (!transcriptPassword) {
  return Astro.redirect('/404')
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData()
  const password = formData.get('password')
  
  if (password === transcriptPassword) {
    Astro.cookies.set('transcript_auth', 'verified', {
      path: '/transcript',
      httpOnly: true,
      secure: true,
      sameSite: 'strict',
      maxAge: 60 * 60 * 24 // 24 hours
    })
    return Astro.redirect('/transcript')
  } else {
    return Astro.redirect('/transcript?error=1')
  }
}
---

<PageLayout meta={{ title: 'Transcript' }}>
  {isAuth ? (
    <div class='flex flex-col items-center gap-6'>
      <p class='text-muted-foreground'>Your transcript is ready.</p>
      
      <div class='w-full max-w-4xl'>
        <!-- Tab Navigation -->
        <div class='flex flex-wrap gap-2 mb-4 border-b pb-2'>
          {transcripts.map((t, i) => (
            <button
              type='button'
              data-tab={i}
              class='tab-btn px-4 py-2 rounded-t-md text-sm font-medium transition-colors bg-muted hover:bg-muted/80'
            >
              {t.label}
            </button>
          ))}
        </div>

        <!-- Tab Content -->
        {transcripts.map((t, i) => (
          <div data-tab-content={i} class:list={['tab-content', { hidden: i !== 0 }]}>
            <!-- Download Button -->
            <a
              href={t.path}
              download={t.name + '.pdf'}
              class='inline-flex items-center gap-2 rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 mb-4'
            >
              <svg xmlns='http://www.w3.org/2000/svg' class='size-5' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
                <path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/>
                <polyline points='7 10 12 15 17 10'/>
                <line x1='12' x2='12' y1='15' y2='3'/>
              </svg>
              Download
            </a>

            <!-- PDF Preview -->
            <iframe
              src={t.path}
              class='w-full rounded-lg border shadow-sm'
              style='height: 75vh;'
              title={t.label}
            />
          </div>
        ))}
      </div>

      <!-- Logout -->
      <form method='POST' action='/transcript?logout=1'>
        <button
          type='submit'
          class='mt-4 text-sm text-muted-foreground underline hover:text-foreground'
        >
          Logout
        </button>
      </form>
    </div>
  ) : (
    <div class='flex flex-col items-center justify-center min-h-[50vh] gap-6'>
      <div class='w-full max-w-sm space-y-4'>
        <div class='text-center mb-6'>
          <h1 class='text-2xl font-semibold mb-2'>Transcript</h1>
          <p class='text-muted-foreground'>Please enter the password to view.</p>
        </div>

        {Astro.url.searchParams.get('error') && (
          <div class='p-3 text-sm text-red-600 bg-red-50 rounded-md dark:bg-red-900/20 dark:text-red-400'>
            Incorrect password. Please try again.
          </div>
        )}

        <form method='POST' class='space-y-4'>
          <div>
            <input
              type='password'
              name='password'
              placeholder='Enter password'
              required
              class='w-full px-4 py-3 rounded-md border bg-background text-sm focus:outline-none focus:ring-2 focus:ring-primary'
            />
          </div>
          <button
            type='submit'
            class='w-full py-3 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 transition-colors'
          >
            Submit
          </button>
        </form>
      </div>
    </div>
  )}
</PageLayout>

<script>
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn')
  const tabContents = document.querySelectorAll<HTMLElement>('.tab-content')
  const activeBtnClass = 'bg-primary text-primary-foreground'
  const inactiveBtnClass = 'bg-muted hover:bg-muted/80'

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabIndex = btn.dataset.tab

      // Update buttons
      tabBtns.forEach(b => {
        b.classList.remove(...activeBtnClass.split(' '))
        b.classList.add(...inactiveBtnClass.split(' '))
      })
      btn.classList.remove(...inactiveBtnClass.split(' '))
      btn.classList.add(...activeBtnClass.split(' '))

      // Update content
      tabContents.forEach(content => {
        if (content.dataset.tabContent === tabIndex) {
          content.classList.remove('hidden')
        } else {
          content.classList.add('hidden')
        }
      })
    })
  })

  // Initialize first tab as active
  tabBtns[0]?.click()
</script>
